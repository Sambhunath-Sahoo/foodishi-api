# Template. Copy to .env and fill in. NEVER commit .env itself.
#
#   cp .env.example .env

# ---------------------------------------------------------------- database
# MUST use the postgresql+asyncpg:// scheme, and MUST NOT carry a ?sslmode=
# parameter -- don't paste Supabase's dashboard string verbatim. TLS is
# negotiated and VERIFIED by app/db.py against supabase-root-2021-ca.crt, which
# is committed alongside it; the app refuses to start without that file.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres

# ------------------------------------------------------------------- auth
# Defaults to TRUE when unset. Set it to false ONLY on a laptop: with auth off,
# every route accepts an unsigned `X-Dev-User-Id: <users.id>` header and trusts
# it, so anyone who can reach the port can act as any customer or any
# restaurant's admin by guessing an integer.
#
# Only 1/true/yes/on and 0/false/no/off are accepted. Anything else is a startup
# error rather than a silent "false" -- a typo here used to disable
# authentication.
AUTH_ENABLED=true

# Your Supabase project. SUPABASE_URL also derives the expected token issuer.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# Public by design — it ships in every frontend bundle. This service never reads
# it; it is here because the consoles need it and this is the one place the full
# set is written down. It is NOT a substitute for a token: tokens are checked for
# aud="authenticated", so a leaked publishable key cannot be replayed as one.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# ---------------------------------------------------------------- secrets
# Service-role key. BYPASSES row-level security, so it is the whole schema in one
# string. Server-side only -- never let it reach a client bundle. Rotate it in
# the Supabase dashboard if it has ever been pasted anywhere it should not be.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# The shared secret the payment gateway presents on
# POST /payments/{id}/callback. With AUTH_ENABLED=true and this UNSET, every
# callback is REFUSED -- deliberately, because that route decides whether an
# order counts as paid and "no secret configured" must not mean "anyone may
# settle a payment".
PAYMENT_WEBHOOK_SECRET=REPLACE_ME

# ------------------------------------------------------------------- cors
# Comma-separated. Defaults to the local dev trio (operator :3000,
# partner :3001, customer :3002) on both localhost and 127.0.0.1.
# CORS_ORIGINS=https://operator.example.com,https://partner.example.com
